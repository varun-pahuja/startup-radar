# Copy to .env and fill in. .env is gitignored — never commit it.

# GitHub (5000 req/hr vs 60 anonymous). Optional but recommended.
GITHUB_TOKEN=

# SQLite by default; point at Postgres later if you want.
DATABASE_URL=sqlite:///data/startup_radar.db

# LLM enrichment (optional). Any OpenAI-compatible endpoint:
# Groq / Google AI Studio / OpenRouter / local Ollama / LM Studio.
# Leave LLM_ENABLED=false to run on heuristics only.
LLM_ENABLED=false
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# Optional cloud exports (Phase 6)
GOOGLE_SERVICE_ACCOUNT_JSON=
NOTION_TOKEN=
